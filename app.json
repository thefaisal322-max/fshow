{
  "expo": {
    "name": "Faisal Show",
    "slug": "fshow",
    "scheme": "fshow",
    "version": "0.11.2",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "android": {
      "package": "org.fainet.fshow",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-bg.png",
        "backgroundColor": "#D63AF9"
      },
      "versionCode": 19
    },
    "ios": {
      "bundleIdentifier": "org.fainet.fshow"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Faisal Show needs your photos and videos so you can share them."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFF0F7"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Faisal Show uses your location only when you add a place to a post."
        }
      ],
      "expo-video",
      [
        "expo-audio",
        {
          "microphonePermission": "Faisal Show uses the microphone only while you record a voice message."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Faisal Show saves videos and photos you download to your gallery.",
          "savePhotosPermission": "Faisal Show saves videos and photos you download to your gallery.",
          "isAccessMediaLocationEnabled": false
        }
      ]
    ],
    "icon": "./assets/icon.png"
  }
}
